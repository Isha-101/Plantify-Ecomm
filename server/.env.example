# Copy this file to `.env` and adjust.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/plantify

# REQUIRED in production – use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Store settings (INR)
SHIPPING_FLAT=79
FREE_SHIPPING_OVER=999

# Order simulation: how long (ms) each order stage lasts before moving to the next one.
# 120000 = 2 minutes per stage, so a demo order is "Delivered" after ~8 minutes.
ORDER_STAGE_MS=120000
